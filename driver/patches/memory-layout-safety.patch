diff -Naur a/src/nvidia/src/kernel/gpu/mem_mgr/mem_mgr.c b/src/nvidia/src/kernel/gpu/mem_mgr/mem_mgr.c
--- a/src/nvidia/src/kernel/gpu/mem_mgr/mem_mgr.c	2026-07-18 11:26:26.862962399 -0700
+++ b/src/nvidia/src/kernel/gpu/mem_mgr/mem_mgr.c	2026-08-06 20:45:00.000000000 +0900
@@ -1163,6 +1163,197 @@
         }

         NV_ASSERT_OK_OR_RETURN(kmemsysPostHeapCreate_HAL(pGpu, pKernelMemorySystem));
+
+        //
+        // CMP 170HX WPR/PMA safety revision wpr-safe-r3.
+        //
+        // The normal RM/GSP initialization above owns the framebuffer region
+        // table and PMA registrations.  cmpunlocker must never reinterpret a
+        // region marked reserved as missing public memory.  In particular,
+        // the removed late-PMA experiment registered the top reserved region
+        // and then cleared its reservation flags, exposing the running GSP
+        // WPR/firmware heap to CUDA allocations.
+        //
+        // This block is diagnostic-only.  It does not register PMA regions,
+        // alter FB descriptors, clear reservation flags, free pages, or change
+        // allocator accounting.  The logs intentionally report both the RM FB
+        // view and PMA region descriptors so a later failure can be localized.
+        // Descriptor coverage is not proof that pinned pages are allocatable.
+        //
+        {
+            NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+            if (devId == 0x20C2 || devId == 0x2082)
+            {
+                Heap *pHeap = pMemoryManager->pHeap;
+                PMA *pPma = NULL;
+                KernelGsp *pKernelGsp = GPU_GET_KERNEL_GSP(pGpu);
+                PMA_REGION_DESCRIPTOR *pPmaRegions = NULL;
+                NV_STATUS pmaRegionStatus = NV_ERR_INVALID_STATE;
+                NvBool bPmaReady = NV_FALSE;
+                NvBool bWprAvailable = NV_FALSE;
+                NvBool bWprCoveredByPmaDescriptor = NV_FALSE;
+                NvU64 heapFree = 0, heapTotal = 0;
+                NvU64 pmaFree = 0, pmaTotal = 0;
+                NvU64 pmaClientAddrSpace = 0;
+                NvU64 largestFree = 0, largestRegionBase = 0, largestOffset = 0;
+                NvU64 regionBytes = 0, publicBytes = 0;
+                NvU64 reservedBytes = 0, internalBytes = 0;
+                NvU64 wprStart = 0, wprEnd = 0;
+                NvU64 wprHeapStart = 0, wprHeapSize = 0, wprHeapEnd = 0;
+                NvU32 numPmaRegions = 0;
+                NvU32 reservedDescriptorCovered = 0;
+                NvU32 fbWprOverlapCount = 0;
+                NvU32 pmaWprOverlapCount = 0;
+                NvU32 ri;
+
+                if (pHeap != NULL)
+                {
+                    heapGetFree(pHeap, &heapFree);
+                    heapGetSize(pHeap, &heapTotal);
+                    pPma = pHeap->pPmaObject;
+                    bPmaReady = (pPma != NULL) &&
+                                memmgrIsPmaInitialized(pMemoryManager);
+                    if (bPmaReady)
+                    {
+                        pmaGetFreeMemory(pPma, &pmaFree);
+                        pmaGetTotalMemory(pPma, &pmaTotal);
+                        pmaGetClientAddrSpaceSize(pPma, &pmaClientAddrSpace);
+                        pmaGetLargestFree(pPma, &largestFree,
+                                          &largestRegionBase, &largestOffset);
+                        pmaRegionStatus = pmaGetRegionInfo(
+                            pPma, &numPmaRegions, &pPmaRegions);
+                    }
+                }
+
+                if (pKernelGsp != NULL && pKernelGsp->pWprMeta != NULL)
+                {
+                    wprStart = pKernelGsp->pWprMeta->gspFwWprStart;
+                    wprEnd = pKernelGsp->pWprMeta->gspFwWprEnd;
+                    wprHeapStart = pKernelGsp->pWprMeta->gspFwHeapOffset;
+                    wprHeapSize = pKernelGsp->pWprMeta->gspFwHeapSize;
+                    if (wprHeapSize > 0 &&
+                        wprHeapStart <= (~0ULL - (wprHeapSize - 1)))
+                    {
+                        wprHeapEnd = wprHeapStart + wprHeapSize - 1;
+                    }
+                    bWprAvailable = (wprStart <= wprEnd) && (wprEnd != 0);
+                    if (bPmaReady && bWprAvailable)
+                    {
+                        bWprCoveredByPmaDescriptor = pmaIsPmaManaged(
+                            pPma, wprStart, wprEnd);
+                    }
+                }
+
+                for (ri = 0; ri < pMemoryManager->Ram.numFBRegions; ri++)
+                {
+                    FB_REGION_DESCRIPTOR *pRegion =
+                        &pMemoryManager->Ram.fbRegion[ri];
+                    NvU64 size = (pRegion->limit >= pRegion->base)
+                                     ? pRegion->limit - pRegion->base + 1
+                                     : 0;
+                    NvBool bRangeCoveredByPmaDescriptor = bPmaReady && (size != 0) &&
+                        pmaIsPmaManaged(pPma, pRegion->base, pRegion->limit);
+                    NvBool bOverlapsWpr = bWprAvailable && (size != 0) &&
+                        (pRegion->base <= wprEnd) &&
+                        (wprStart <= pRegion->limit);
+
+                    regionBytes += size;
+                    if (pRegion->bInternalHeap)
+                    {
+                        internalBytes += size;
+                    }
+                    else if (pRegion->bRsvdRegion)
+                    {
+                        reservedBytes += size;
+                        if (bRangeCoveredByPmaDescriptor)
+                            reservedDescriptorCovered++;
+                    }
+                    else
+                    {
+                        publicBytes += size;
+                    }
+                    if (bOverlapsWpr)
+                        fbWprOverlapCount++;
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "CMP_MEM_REGION: revision=wpr-safe-r3 idx=%u "
+                              "base=0x%llx limit=0x%llx size=0x%llx "
+                              "rsvd=%u rsvdSize=0x%llx intHeap=%u "
+                              "compressed=%u iso=%u protected=%u "
+                              "pmaDescriptorCovers=%u overlapsWpr=%u\n",
+                              ri, pRegion->base, pRegion->limit, size,
+                              pRegion->bRsvdRegion, pRegion->rsvdSize,
+                              pRegion->bInternalHeap,
+                              pRegion->bSupportCompressed,
+                              pRegion->bSupportISO, pRegion->bProtected,
+                              bRangeCoveredByPmaDescriptor, bOverlapsWpr);
+                }
+
+                if (pmaRegionStatus == NV_OK &&
+                    (numPmaRegions == 0 || pPmaRegions != NULL))
+                {
+                    for (ri = 0; ri < numPmaRegions; ri++)
+                    {
+                        PMA_REGION_DESCRIPTOR *pRegion = &pPmaRegions[ri];
+                        NvBool bOverlapsWpr = bWprAvailable &&
+                            (pRegion->base <= pRegion->limit) &&
+                            (pRegion->base <= wprEnd) &&
+                            (wprStart <= pRegion->limit);
+
+                        if (bOverlapsWpr)
+                            pmaWprOverlapCount++;
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "CMP_MEM_PMA_REGION: revision=wpr-safe-r3 "
+                                  "idx=%u base=0x%llx limit=0x%llx perf=%u "
+                                  "compressed=%u iso=%u protected=%u "
+                                  "overlapsWpr=%u\n",
+                                  ri, pRegion->base, pRegion->limit,
+                                  pRegion->performance,
+                                  pRegion->bSupportCompressed,
+                                  pRegion->bSupportISO,
+                                  pRegion->bProtected, bOverlapsWpr);
+                    }
+                }
+                else
+                {
+                    NV_PRINTF(LEVEL_ERROR,
+                              "CMP_MEM_PMA_REGION_STATUS: revision=wpr-safe-r3 "
+                              "status=0x%x count=%u descriptors=%p\n",
+                              pmaRegionStatus, numPmaRegions, pPmaRegions);
+                }
+
+                NV_PRINTF(LEVEL_ERROR,
+                          "CMP_MEM_SAFE_PMA: revision=wpr-safe-r3 devId=0x%x "
+                          "late_extension=disabled pmaReady=%u "
+                          "pmaRegionStatus=0x%x fbAddrSpace=%lluMB "
+                          "mapRam=%lluMB fbTotal=%lluMB fbUsable=0x%llx "
+                          "heapTotal=0x%llx heapFree=0x%llx "
+                          "pmaTotal=0x%llx pmaFree=0x%llx "
+                          "pmaClientAddrSpace=0x%llx largestFree=0x%llx "
+                          "largestRegionBase=0x%llx largestOffset=0x%llx "
+                          "regionBytes=0x%llx publicBytes=0x%llx "
+                          "reservedBytes=0x%llx internalBytes=0x%llx "
+                          "numFbRegions=%u numPmaRegions=%u "
+                          "wprAvailable=%u wprStart=0x%llx wprEnd=0x%llx "
+                          "wprHeapStart=0x%llx wprHeapEnd=0x%llx "
+                          "wprDescriptorCovers=%u reservedDescriptorCovered=%u "
+                          "fbWprOverlapCount=%u pmaWprOverlapCount=%u\n",
+                          devId, bPmaReady, pmaRegionStatus,
+                          pMemoryManager->Ram.fbAddrSpaceSizeMb,
+                          pMemoryManager->Ram.mapRamSizeMb,
+                          pMemoryManager->Ram.fbTotalMemSizeMb,
+                          pMemoryManager->Ram.fbUsableMemSize,
+                          heapTotal, heapFree, pmaTotal, pmaFree,
+                          pmaClientAddrSpace, largestFree,
+                          largestRegionBase, largestOffset,
+                          regionBytes, publicBytes, reservedBytes,
+                          internalBytes, pMemoryManager->Ram.numFBRegions,
+                          numPmaRegions, bWprAvailable, wprStart, wprEnd,
+                          wprHeapStart, wprHeapEnd, bWprCoveredByPmaDescriptor,
+                          reservedDescriptorCovered, fbWprOverlapCount,
+                          pmaWprOverlapCount);
+            }
+        }
     }

     return status;
@@ -4138,7 +4329,9 @@

     if (!bFifoLite && !RMCFG_FEATURE_PLATFORM_GSP && bVirtualMode &&
         IS_SILICON(pGpu) && !pMemorySystemConfig->bDisableCompbitBacking &&
-        (pMemorySystemConfig->bUseRawModeComptaglineAllocation || pMemorySystemConfig->bOneToOneComptagLineAllocation))
+        (pMemorySystemConfig->bUseRawModeComptaglineAllocation || pMemorySystemConfig->bOneToOneComptagLineAllocation) &&
+        ((pGpu->idInfo.PCIDeviceID >> 16) != 0x20C2 &&
+         (pGpu->idInfo.PCIDeviceID >> 16) != 0x2082))
     {
         // Turn on virtual mode to enable compressed allocation access
         ceUtilsParams.flags |= DRF_DEF(0050_CEUTILS, _FLAGS, _VIRTUAL_MODE, _TRUE);
